<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the Unity layer (Runtime/Unity) and the canonical sample against UnityEngine stubs.
    Catches syntax and API-shape errors only. The real check is a Unity Editor import and compile.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/Core/*.cs" />
    <Compile Include="../../Runtime/Unity/*.cs" />
    <Compile Include="../../Samples/Quickstart/*.cs" />
    <Compile Include="UnityStubs.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
